NODE_ENV=development
ACTIVATE_ALL_FEATURES_DEV=true

# Core URLs (port 3011 is hardcoded in Dust for local dev)
NEXT_PUBLIC_DUST_CLIENT_FACING_URL=http://localhost:3011
REGION=us-central1
CORE_API=http://localhost:3001
CONNECTORS_API=http://localhost:3002
OAUTH_API=http://localhost:3003
TEXT_EXTRACTION_URL=http://localhost:9998
POKE_APP_URL=http://localhost:3011/poke

# Database (matches docker-compose.yml defaults)
FRONT_DATABASE_URI=postgres://dev:dev@localhost:5432/dust_front

# Redis
REDIS_URI=redis://localhost:6379
REDIS_CACHE_URI=redis://localhost:6379

# Elasticsearch (set password to match docker-compose .env)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

# WorkOS (auth) — https://dashboard.workos.com (free dev tier)
# IMPORTANT: Set WORKOS_API_HOSTNAME to override Dust's hardcoded auth-api.dust.tt
WORKOS_API_HOSTNAME=api.workos.com
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=          # Random string, minimum 32 characters
WORKOS_ISSUER_URL=https://api.workos.com/user_management
WORKOS_WEBHOOK_SECRET=STUB_not_needed_for_local_dev
WORKOS_WEBHOOK_SIGNING_SECRET=STUB_not_needed_for_local_dev
WORKOS_ACTION_SECRET=STUB_not_needed_for_local_dev
WORKOS_ACTION_SIGNING_SECRET=STUB_not_needed_for_local_dev
WORKOS_ENVIRONMENT_ID=STUB_not_needed_for_local_dev

# Service secrets (use any random strings for local dev)
DUST_API_AUDIENCE=dust-local-dev
DUST_INVITE_TOKEN_SECRET=local-dev-invite-secret-change-me
DUST_CONNECTORS_SECRET=local-dev-connectors-secret
DUST_CONNECTORS_WEBHOOKS_SECRET=local-dev-connectors-webhooks-secret
DUST_REGISTRY_SECRET=local-dev-registry-secret
DUST_DEVELOPMENT_SYSTEM_API_KEY=sk-local-dev-system-key
DUST_DEVELOPMENT_WORKSPACE_ID=local-dev-workspace
VIZ_JWT_SECRET=local-dev-viz-jwt-secret
DUST_ACADEMY_JWT_SECRET=local-dev-academy-jwt-secret
EMAIL_WEBHOOK_SECRET=local-dev-email-webhook-secret
EMAIL_VALIDATION_SECRET=local-dev-email-validation-secret
GATED_ASSETS_TOKEN_SECRET=local-dev-gated-assets-secret
SERVICE_ACCOUNT={}

# Notifications (Novu) — required by /api/user, will crash without these
NOVU_SECRET_KEY=STUB_novu_secret_key
NEXT_PUBLIC_NOVU_API_URL=https://api.novu.co
NEXT_PUBLIC_NOVU_APPLICATION_IDENTIFIER=STUB_novu_app_id
NEXT_PUBLIC_NOVU_WEBSOCKET_API_URL=https://ws.novu.co

# Third-party services (STUBS — only error if you use the feature)
SENDGRID_API_KEY=STUB
SENDGRID_INVITATION_EMAIL_TEMPLATE_ID=STUB
SENDGRID_GENERIC_EMAIL_TEMPLATE_ID=STUB
STRIPE_SECRET_KEY=STUB
STRIPE_SECRET_WEBHOOK_KEY=STUB
TWILIO_ACCOUNT_SID=STUB
TWILIO_AUTH_TOKEN=STUB
TWILIO_VERIFY_SERVICE_SID=STUB
PERSONA_API_KEY=STUB
IPINFO_API_TOKEN=STUB
CUSTOMERIO_SITE_ID=STUB
CUSTOMERIO_API_KEY=STUB
STATUS_PAGE_API_TOKEN=STUB
STATUS_PAGE_DUST_PAGE_ID=STUB
STATUS_PAGE_PROVIDERS_PAGE_ID=STUB

# OAuth connectors (STUBS — only needed for specific integrations)
OAUTH_GITHUB_APP=STUB
OAUTH_GITHUB_APP_PLATFORM_ACTIONS=STUB
OAUTH_GITHUB_APP_PLATFORM_ACTIONS_CLIENT_ID=STUB
OAUTH_GITHUB_APP_WEBHOOKS_CLIENT_ID=STUB
OAUTH_NOTION_CLIENT_ID=STUB
OAUTH_NOTION_PLATFORM_ACTIONS_CLIENT_ID=STUB
OAUTH_CONFLUENCE_CLIENT_ID=STUB
OAUTH_CONFLUENCE_TOOLS_CLIENT_ID=STUB
OAUTH_GOOGLE_DRIVE_CLIENT_ID=STUB
GOOGLE_DRIVE_PICKER_API_KEY=STUB
OAUTH_SLACK_CLIENT_ID=STUB
OAUTH_SLACK_BOT_CLIENT_ID=STUB
OAUTH_SLACK_TOOLS_CLIENT_ID=STUB
OAUTH_INTERCOM_CLIENT_ID=STUB
OAUTH_GONG_CLIENT_ID=STUB
OAUTH_MICROSOFT_CLIENT_ID=STUB
OAUTH_MICROSOFT_TOOLS_CLIENT_ID=STUB
OAUTH_ZENDESK_CLIENT_ID=STUB
OAUTH_PRODUCTBOARD_CLIENT_ID=STUB
OAUTH_HUBSPOT_CLIENT_ID=STUB
OAUTH_FRESHWORKS_CLIENT_ID=STUB
OAUTH_FRESHWORKS_DOMAIN=STUB
OAUTH_JIRA_CLIENT_ID=STUB
OAUTH_MONDAY_CLIENT_ID=STUB
OAUTH_DISCORD_CLIENT_ID=STUB
OAUTH_FATHOM_CLIENT_ID=STUB
DEV_OAUTH_FATHOM_REDIRECT_BASE_URL=http://localhost:3011
OAUTH_LINEAR_CLIENT_ID=STUB

# Managed LLM API keys (used by Temporal worker for agent loop)
# The worker reads these from env, NOT from the per-workspace provider config.
DUST_MANAGED_GOOGLE_AI_STUDIO_API_KEY=

# Denied integration (optional — feature is off when URL is unset)
DENIED_API_URL=https://api.test.denied.dev
DENIED_API_KEY=dnd_sk_your_key_here
